[Desktop Entry]
Type=Application
Name=@APP_NAME@
GenericName=Screen Zoom and Annotation
Comment=@APP_SUMMARY@
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@APP_BIN@
Icon=@APP_ID@
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=zoom;magnify;magnifier;draw;annotate;presentation;screenshot;snip;timer;zoomit;
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Actions=Zoom;Draw;Snip;Break;Settings;

[Desktop Action Zoom]
Name=Zoom
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@APP_BIN@ zoom

[Desktop Action Draw]
Name=Draw
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@APP_BIN@ draw

[Desktop Action Snip]
Name=Snip to Clipboard
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@APP_BIN@ snip

[Desktop Action Break]
Name=Break Timer
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@APP_BIN@ break

[Desktop Action Settings]
Name=Settings
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@APP_BIN@ settings
